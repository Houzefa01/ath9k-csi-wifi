--- ath-parent/ath9k/debug.c	2026-03-25 00:47:58.584843200 +0300
+++ ath9k-csi/debug.c	2026-03-25 00:38:08.514094000 +0300
@@ -1374,6 +1374,33 @@
 	ath9k_cmn_spectral_deinit_debug(&sc->spec_priv);
 }
 
+
+/* === CSI Tool — debugfs interface === */
+static ssize_t read_csi(struct file *file, char __user *user_buf,
+                        size_t count, loff_t *ppos)
+{
+	struct ath_softc *sc = file->private_data;
+	struct csi_state *cs = &sc->csi;
+	unsigned long flags;
+	ssize_t ret;
+
+	wait_event_interruptible(cs->csi_waitq, cs->csi_ready);
+
+	spin_lock_irqsave(&cs->csi_lock, flags);
+	ret = simple_read_from_buffer(user_buf, count, ppos,
+				      cs->csi_buf.buf, cs->csi_buf.len);
+	cs->csi_ready = false;
+	spin_unlock_irqrestore(&cs->csi_lock, flags);
+	return ret;
+}
+
+static const struct file_operations fops_csi = {
+	.read   = read_csi,
+	.open   = simple_open,
+	.owner  = THIS_MODULE,
+	.llseek = default_llseek,
+};
+/* === End CSI debugfs === */
 int ath9k_init_debug(struct ath_hw *ah)
 {
 	struct ath_common *common = ath9k_hw_common(ah);
@@ -1457,5 +1484,13 @@
 	debugfs_create_file("nf_override", 0600,
 			    sc->debug.debugfs_phy, sc, &fops_nf_override);
 
+
+	/* === CSI Tool — init === */
+	spin_lock_init(&sc->csi.csi_lock);
+	init_waitqueue_head(&sc->csi.csi_waitq);
+	sc->csi.csi_ready = false;
+	debugfs_create_file("csi_dump", 0400,
+			    sc->debug.debugfs_phy, sc, &fops_csi);
+	/* === End CSI init === */
 	return 0;
 }
